{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(Windows) Launch",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "enter program name, for example ${workspaceFolder}/a.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "console": "externalTerminal"
        },
        {
            "name": "(Windows) Attach",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Run prettier",
            "runtimeExecutable": "prettier",
            "cwd": "${workspaceFolder}",
            "args": []
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Run prettier",
            "program": "${workspaceFolder}/node_modules/.bin/prettier",
            "cwd": "${workspaceFolder}",
            "args": []
        },
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Attach to Chrome",
            // Chrome DevTools remote debugging protocol port (not the app HTTP PORT/URL)
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Node Launch Current File",
            "type": "node",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Node: Launch App Server",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/app/index.js",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Node: Attach to Process",
            "type": "node",
            "request": "attach",
            "processId": "${command:PickProcess}",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Node: Run npm script 'format'",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "format",
                "--silent"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Debug: Node Current File (and attach)",
            "configurations": [
                "Node Launch Current File"
            ]
        },
        {
            "name": "Format + Launch App Server",
            "configurations": [
                "Node: Launch App Server"
            ],
            "preLaunchTask": "npm: format"
        }
    ]
}
