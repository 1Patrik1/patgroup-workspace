{
    "name": "patgroup-workspace",
    "version": "1.0.0",
    "description": "PATGROUP - stavba management system s web UI",
    "main": "app/index.js",
    "private": true,
    "scripts": {
        "start": "node app/index.js",
        "start:trace": "node --require ./tracing.js app/index.js",
        "format": "prettier --write .",
        "check": "node scripts/check.js",
        "check-server": "node scripts/check-server.js",
        "test": "node scripts/check.js && node scripts/check-server.js"
    },
    "devDependencies": {
